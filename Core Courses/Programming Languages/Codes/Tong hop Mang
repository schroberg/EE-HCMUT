#include <stdio.h>
int laSNT(int n)
{
    if (n < 2) return 0;
    for (int i = 2; i*i <= n; i++)
    {
        if (n%i == 0) return 0;
    }
    return 1;
}
int laSCP(int n)
{
    if (n < 0) return 0;
    for (int i = 1; i*i <= n; i++)
    {
        if (i*i == n) return i;
    }
    return 0;
}
int laSDX(int n)
{
    int x = 0, t = n;
    while (t > 0)
    {
        x = x*10 + t%10;
        t = t/10;
    }
    return (x == n);
}
