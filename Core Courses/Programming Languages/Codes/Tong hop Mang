void CongMaTran(int a[][100], int b[][100], int m, int n)
{
    int c[100][100];
    for(int i = 0; i < m; i++)
    {
        for(int j = 0; j < n; j++)
        {
            c[i][j] = a[i][j] + b[i][j];
        }
    }
    for (int i = 0; i < m; i++)
    {
        for (int j = 0; j < n; j++)
        {
            printf("%d \t",c[i][j]);
        }
        printf("\n");
    }
}
void NhanSoVoiMaTran(int a[][100],int m, int n,int k)
{
