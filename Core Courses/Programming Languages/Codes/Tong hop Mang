void NhanHaiMaTran(int a[][100], int b[][100], int m1, int n1, int m2, int n2)
{
    int C[100][100];
    if (n1 == m2)
    {
        printf("Ma tran A nhan Ma tran B\n");
        for(int i = 0; i < m1; i++)
        {
            for (int j = 0; j < n2; j++)
            {
                C[i][j] = 0;
            }
        }
        for (int i = 0; i < m1; i++)
        {
            for (int j = 0; j < n2; j++)
            {
                for (int k = 0; k < n1; k++)
                {
                    C[i][j] += a[i][k] * b[k][j];
                }
            }
        }
        for (int i = 0; i < m1; i++)
        {
            for (int j = 0; j < n2; j++)
            {
                printf("%d \t",C[i][j]);
            }
            printf("\n");
        }
    }
    if (n2 == m1)
    {
        printf("Ma tran B nhan Ma tran A\n");
        for (int i = 0; i < m2; i++)
        {
            for (int j = 0; j < n1; j++)
            {
                C[i][j] = 0;
            }
        }
        for (int i = 0; i < m2; i++)
        {
            for (int j = 0; j < n1; j++)
            {
                for (int k = 0; k < n2; k++)
                {
                    C[i][j] += b[i][k] * a[k][j];
                }
            }
        }
        for (int i = 0; i < m2; i++)
        {
            for (int j = 0; j < n1; j++)
            {
                printf("%d \t",C[i][j]);
            }
            printf("\n");
        }
    }
}
