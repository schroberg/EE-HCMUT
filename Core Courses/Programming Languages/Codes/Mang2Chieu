int laSNT(int n)
{
    if (n < 2) return 0;
    for (int i = 2; i*i <= n; i++)
    {
        if (n%i == 0)
            return 0;
    }
    return 1;
}
void SNT(int a[][100],int b[][100], int m, int n)
{
    printf("Cac gia tri so nguyen to cua mang:");
    for (int i = 0; i < m; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if(laSNT(a[i][j]))
            {
                b[i][j] = a[i][j];
                printf("%d ",a[i][j]);
            }
        }
    }
    printf("\n");
}
int laSCP(int n)
{
    if (n < 0) return 0;
    for (int i = 1; i*i <= n; i++)
    {
        if (i*i == n) return 1;
    }
    return 0;
}
void SCP(int a[][100],int c[][100],int m, int n)
{
    printf("Cac gia tri so chinh phuong cua mang la:");
    for (int i = 0; i < m; i++)
    {
        for (int j = 0; j < n; j++)
        {
            if(laSCP(a[i][j]))
            {
                c[i][j] = a[i][j];
                printf("%d ",a[i][j]);
            }
        }
    }
    printf("\n");
}
